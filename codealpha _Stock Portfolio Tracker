portfolio = {}

def add_stock():
    name = input("Enter stock name: ").upper()
    quantity = int(input("Enter quantity: "))
    price = float(input("Enter stock price: "))

    portfolio[name] = {
        "quantity": quantity,
        "price": price
    }

    print("Stock added successfully!")

def view_portfolio():
    total = 0

    print("\n--- STOCK PORTFOLIO ---")

    for name, details in portfolio.items():
        value = details["quantity"] * details["price"]
        total += value

        print("Stock:", name)
        print("Quantity:", details["quantity"])
        print("Price:", details["price"])
        print("Total:", value)
        print("-------------------")

    print("Total Portfolio Value:", total)

def main():
    while True:
        print("\n1. Add Stock")
        print("2. View Portfolio")
        print("3. Exit")

        choice = input("Enter choice: ")

        if choice == "1":
            add_stock()

        elif choice == "2":
            view_portfolio()

        elif choice == "3":
            print("Thank you!")
            break

        else:
            print("Invalid choice!")

main()
